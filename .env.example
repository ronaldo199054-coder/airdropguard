# AirdropGuard configuration (copy to .env). Never put private keys or seed phrases here.

# Public Concordium TESTNET account of the operator (public address, not a secret).
# Reserved for the x402 pay-to address once paid checks are enabled. No transactions are sent in v0.
OPERATOR_ACCOUNT=3bUUnm74gLHNTdujDFvtEwHevnqTX4asdDCvXNKbdMLYJD2GM3

# Network the operator runs on (hackathon build: testnet only).
CONCORDIUM_NETWORK=testnet

# Hosted Concordium Agent Registry (REST + MCP). No auth; per-IP rate limit.
AGENT_REGISTRY_URL=https://agent-registry-mcp.concordium.com

# RDAP bootstrap used for domain age / registrar lookups.
RDAP_URL=https://rdap.org

# HTTP API
PORT=8787

# x402 paid API (STUB ONLY in v0 — no real payment verification yet)
X402_ENABLED=false
X402_PRICE=0.01
X402_ASSET=CCD

# Per-request network timeout in ms
HTTP_TIMEOUT_MS=10000
